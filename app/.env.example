# Optional. Copy to .env.local (ignored by git) to prefill the Breeze app key in Settings.
# On Vercel, add it as an environment variable instead. It is baked into the built page, so anyone
# who can open the site can read it. Never commit a real value.
VITE_BREEZE_APP_KEY=

# Needed for market data (and the sign-in) in `npm run dev` and `vite preview`: the deployment they read from, with no
# trailing slash, for example https://your-project.vercel.app. There is no default, so the app shows no market data until set.
# Sign-in passwords you type in dev are sent to this origin, so only point it at a deployment you control.
MARKET_DATA_ORIGIN=
