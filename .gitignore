# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Tool caches and reports (regenerated by vite / vitest)
.vite/
.vite-temp/
.vitest/
.vitest-cache/
coverage/

# Secrets and local environment. Provider credentials live in the browser's IndexedDB, never in files,
# but ignore env files anyway so a future Vercel or local setup cannot commit one by accident.
.env
.env.*
!.env.example
.vercel/

# Logs
*.log
npm-debug.log*

# OS and editor noise
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings (project-shared settings.json is fine to commit)
.claude/settings.local.json
